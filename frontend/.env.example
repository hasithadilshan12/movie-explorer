# URL of the Movie Explorer API (Express backend)
VITE_API_URL=http://localhost:5000

# TMDB API key (v3). Optional — the app ships with a working fallback key.
VITE_TMDB_API_KEY=your-tmdb-api-key

# Google OAuth "Web application" client ID.
# Must match GOOGLE_CLIENT_ID in the backend .env file.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
